rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Immagini profilo (Step 42): ogni utente scrive solo nel proprio
    // percorso profile_images/{uid}/..., lettura per chiunque sia
    // autenticato (avatar visibili in liste condivise: iscrizioni,
    // squadra, classifica).
    match /profile_images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Tutto il resto del bucket (tracciati GPX/KML, log diagnostici, ecc.):
    // comportamento invariato. `allPaths[0] != 'profile_images'` esclude
    // esplicitamente quel prefisso da qui, altrimenti questa regola più
    // permissiva si sommerebbe a quella sopra (le regole Storage si
    // uniscono, non vince la più specifica) vanificando la restrizione.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
          allPaths[0] != 'profile_images';
    }
  }
}
