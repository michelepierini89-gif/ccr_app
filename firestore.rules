rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Admin bypass — l'admin ha sempre accesso completo, in aggiunta alle regole
    // più specifiche sotto (Firestore concede l'accesso se ALMENO una regola lo permette)
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Lettura per qualunque utente autenticato (Step 42: l'avatar profilo
    // va mostrato anche di compagni di squadra e altri concorrenti, nelle
    // iscrizioni, in squadra e in classifica — stesso livello di apertura
    // già usato per eventi/iscrizioni/squadre in questo file). Scrittura
    // resta riservata al proprietario del profilo.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ── User notifications ────────────────────────────────────────────────────
    // Ogni utente legge solo le proprie notifiche; admin scrive per approvazioni
    match /user_notifications/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /{subcollection=**} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ── Events ────────────────────────────────────────────────────────────────
    // (startingOrder è un campo del documento evento → coperto da questa regola)
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // Iscrizioni — collezione reale 'iscritti'
      match /iscritti/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }

      // Alias 'registrations' (compatibilità futura, stesso significato di 'iscritti')
      match /registrations/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }

      // Squadre — collezione reale 'squadre'
      match /squadre/{teamId} {
        allow read, write: if isAuthenticated();
      }

      // Ordine di partenza — collezione (se mai estratta dal documento evento)
      match /startingOrder/{slotId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Tempi delle speciali — placeholder per futura collezione dedicata
      // (oggi i tempi sono calcolati da tracking/{eventId}/passages)
      match /speciali_tempi/{tempoId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Piloti dell'evento — placeholder per futura collezione dedicata
      // (oggi le posizioni live sono in tracking/{eventId}/pilots)
      match /pilots/{pilotId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Override penalità contestuale all'evento
      match /penalty_settings/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Ritiri
      match /withdrawals/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId);
      }

      // Notifiche admin (inbox iscrizioni) — tutti scrivono, solo admin legge
      match /notifications/{notifId} {
        allow create: if isAuthenticated();
        allow read: if isAdmin();
      }
    }

    // ── GPS Tracking ──────────────────────────────────────────────────────────
    // Posizioni live — solo il proprio pilota scrive; lettura ad admin
    // (mappa live/gestione) E al proprio pilota (privacy verso gli ALTRI
    // piloti, non verso se stesso: gli serve per il proprio riepilogo
    // post-gara — RaceResultScreen/myPilotStatusStream — e per sapere con
    // quale variante di percorso ha corso, Fix 10/08/2026 Parte 5).
    match /tracking/{eventId}/pilots/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isOwner(userId);

      // Fix 5 (09/08/2026) — chunk della traccia grezza completa (vedi
      // FirestoreService.saveFullPilotTrack), stessa visibilità del
      // documento pilota padre: solo il proprio pilota scrive (durante la
      // gara), solo admin legge (serve al ricalcolo tempi ufficiali).
      match /fullTrackChunks/{chunkId} {
        allow read: if isAdmin();
        allow write: if isOwner(userId);
      }

      // Eventi di allenamento (Step 47, Parte 2B) — un tentativo è
      // scritto SOLO dal proprio pilota, letto SOLO dal proprietario e
      // dall'admin: stesso criterio del documento pilota padre sopra,
      // perché il documento tentativo contiene `pilotTrack` (posizioni
      // GPS grezze, scritto da savePilotTrack a fine tentativo/ritiro) —
      // MAI leggibile da un pilota estraneo (fix Step 51, era
      // `isAuthenticated()`: qualunque utente autenticato poteva leggere
      // le posizioni GPS di chiunque altro). Stesso criterio esteso a
      // tutto ciò che vi è annidato (chunk traccia, passaggi, violazioni
      // zona velocità). La classifica di allenamento (miglior tempo per
      // PS tra tutti i piloti) NON legge più da qui: legge dal riepilogo
      // pubblico in tracking/{eventId}/trainingResults sotto, popolato
      // dal proprietario alla chiusura di ogni tentativo.
      match /attempts/{attemptId} {
        allow read: if isAdmin() || isOwner(userId);
        allow write: if isOwner(userId);

        match /fullTrackChunks/{chunkId} {
          allow read: if isAdmin() || isOwner(userId);
          allow write: if isOwner(userId);
        }
        match /passages/{passageId} {
          allow read: if isAdmin() || isOwner(userId);
          allow write: if isOwner(userId);
        }
        match /speedZoneViolations/{violationId} {
          allow read: if isAdmin() || isOwner(userId);
          allow write: if isOwner(userId);
        }
      }
    }

    // Riepilogo pubblico dei tempi per prova speciale di un tentativo di
    // allenamento concluso (Step 51) — SOLO tempi/esiti per PS, MAI
    // posizioni GPS: a differenza di tracking/{eventId}/pilots/{userId}/
    // attempts sopra (owner+admin, contiene pilotTrack), questa collezione
    // è piatta sull'evento (non annidata sotto pilots/{userId}) proprio
    // per essere leggibile con una query di collezione normale — non una
    // collectionGroup query, che le regole non autorizzano per un match a
    // profondità fissa come quello sopra. Scritto (creato/aggiornato) dal
    // proprietario del tentativo ad ogni chiusura (non solo sui record:
    // più semplice, più robusto, serve anche allo storico personale — la
    // logica "è il miglior tempo di squadra" resta tutta in lettura, in
    // TrainingClassificaEngine).
    match /tracking/{eventId}/trainingResults/{attemptId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Percorso alternativo (10/08/2026, Parte 5) — userId -> routeVariantId,
    // stessa visibilità di 'passages': tutti gli autenticati, perché la
    // classifica (guardata anche dai piloti) deve sapere con quale
    // variante ha corso ogni pilota, non solo il proprio.
    match /tracking/{eventId}/routeVariantByUser/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Tempi ufficiali ricalcolati post-gara (Blocco B) — scoperta durante la
    // ricognizione Step 51 (punto 1): introdotta senza regola dedicata,
    // coperta finora SOLO dal bypass admin sopra — ogni pilota che
    // guardasse la classifica di un evento con tempi ufficiali già
    // ricalcolati avrebbe ricevuto permission-denied (classificaProvider
    // guarda `officialTimesStreamProvider` per TUTTI, non solo l'admin).
    // Scritto SOLO dall'admin (il ricalcolo in TimingScreen legge
    // `fullTrackChunks` di ogni pilota, già admin-only: un pilota non
    // potrebbe comunque completare il calcolo), letto da tutti gli
    // autenticati come 'passages' sotto.
    match /tracking/{eventId}/officialTimes/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Passaggi ai waypoint — tutti gli autenticati leggono/scrivono (classifica)
    match /tracking/{eventId}/passages/{passageId} {
      allow read, write: if isAuthenticated();
    }

    // Violazioni zona a velocità controllata — stessa visibilità di
    // 'passages': tutti gli autenticati leggono/scrivono perché la
    // classifica (anche quella del pilota stesso) deve includere la
    // penalità nel tempo finale. Il dettaglio (nome zona, velocità) viene
    // mostrato solo all'admin a livello di UI, non di sicurezza dati.
    match /tracking/{eventId}/speedZoneViolations/{violationId} {
      allow read, write: if isAuthenticated();
    }

    // Segnalazioni pilota di CP rilevati erroneamente come mancati (Fix 4,
    // 09/08/2026): il pilota crea la propria segnalazione SOLO per un
    // evento a cui è iscritto (previene creazioni a nome di eventi/pilotI
    // arbitrari), legge solo le proprie; l'admin (bypass globale sopra)
    // legge tutte e ne aggiorna lo stato.
    match /cp_disputes/{eventId}/disputes/{disputeId} {
      allow read: if isAuthenticated() &&
          resource.data.pilotId == request.auth.uid;
      allow create: if isAuthenticated() &&
          request.resource.data.pilotId == request.auth.uid &&
          exists(/databases/$(database)/documents/events/$(eventId)/iscritti/$(request.auth.uid));
      allow update: if isAdmin();
    }

    // Alias 'gps_tracks' (compatibilità futura, stesso significato di 'tracking')
    match /gps_tracks/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Championships ─────────────────────────────────────────────────────────
    match /championships/{champId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Penalty settings ──────────────────────────────────────────────────────
    match /penalty_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
