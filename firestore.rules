rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Events ────────────────────────────────────────────────────────────────

    match /events/{eventId} {
      // Pilots can read open events; admins can read all
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();

      // Registrations (iscritti)
      match /iscritti/{userId} {
        allow read: if isAdmin() || isOwner(userId);
        // Pilot can create their own registration
        allow create: if isOwner(userId) &&
          request.resource.data.stato == 'inAttesa';
        // Only admin can update status; pilot can update their own non-status fields
        allow update: if isAdmin() ||
          (isOwner(userId) &&
           !('stato' in request.resource.data.diff(resource.data).affectedKeys()));
        allow delete: if isAdmin();
      }

      // Teams (squadre)
      match /squadre/{teamId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }

      // Notifications (admin reads, system writes)
      match /notifications/{notifId} {
        allow read: if isAdmin();
        allow create: if isAuthenticated();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      // Withdrawals
      match /withdrawals/{userId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── User notifications ────────────────────────────────────────────────────

    match /user_notifications/{userId} {
      match /items/{itemId} {
        // Users read and update (mark read) their own notifications
        allow read, update, delete: if isOwner(userId);
        // Any authenticated user (including admin) can create notifications for others
        allow create: if isAuthenticated();
      }
    }

    // ── Tracking ──────────────────────────────────────────────────────────────

    match /tracking/{eventId} {
      allow read: if isAdmin();

      match /pilots/{userId} {
        // Pilot writes their own GPS position; admin reads all
        allow read: if isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /passages/{passageId} {
        // Pilot writes their own waypoint passages; admin reads all
        allow read: if isAdmin() ||
          (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }
  }
}
